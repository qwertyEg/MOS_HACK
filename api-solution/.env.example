# Ключ z.ai (https://z.ai/manage-apikey). Если ключ с open.bigmodel.cn —
# поменяйте ZAI_BASE_URL на https://open.bigmodel.cn/api/paas/v4
ZAI_API_KEY=
ZAI_BASE_URL=https://api.z.ai/api/paas/v4
GLM_MODEL=glm-4.6v

# Локальная модель (подключение — docs/local-model.md)
LOCAL_VLM_BASE_URL=http://localhost:11435/v1
LOCAL_VLM_MODEL=qwen3-vl:30b-a3b-instruct
LOCAL_VLM_API_KEY=
