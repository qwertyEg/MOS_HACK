# Скопировать в .env и поправить под свою машину.

# --- база ---
DATABASE_URL=postgresql+psycopg://stroyka:stroyka@localhost:5432/stroyka

# --- хранилище кадров ---
# s3 = MinIO из docker-compose. local = папка на диске, страховка на случай,
# если MinIO не поднимется в момент демонстрации.
STORAGE_BACKEND=s3
S3_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET=frames

# --- модель Б ---
# 11435 — Bearer-защищённый прокси к Ollama; сам Ollama доступен только на
# 127.0.0.1:11436. Сгенерируйте ключ командой `openssl rand -hex 32`.
# Если приложение работает на другой машине, задайте HTTPS URL reverse proxy:
# VLM_BASE_URL=https://home.udron.ru/ollama/v1
VLM_BASE_URL=http://localhost:11435/v1
VLM_API_KEY=
VLM_MODEL=qwen3-vl:30b-a3b-instruct

# Бюджет большой не потому, что нужен длинный ответ — ответ односложный.
# Qwen3-VL рассуждает перед ответом всегда, отключить это не удаётся
# ни через think:false, ни через enable_thinking, ни через reasoning_effort.
# Если бюджета не хватит, он уйдёт на рассуждение, а content придёт пустым.
VLM_MAX_TOKENS=512

# --- приём кадров с камер ---
# Адрес, по которому камера достучится до этого сервиса. Камера живёт своим
# процессом (в жизни — на другой машине), и localhost для неё не обязательно
# мы. Этот адрес сервис сообщает камере при подключении.
PUBLIC_BASE_URL=http://localhost:8000

# Разбирать ли приходящие кадры моделью Б. Выключите, если нужно посмотреть
# только на работу маски и не ждать VLM.
LIVE_MODEL_B=true
# Сколько времени СЪЁМКИ должно пройти между вызовами модели Б. Считается по
# метке кадра, а не по настенным часам: при ускоренном показе сутки съёмки
# проходят за минуту, и по часам вызов оказался бы один на весь прогон.
LIVE_MODEL_B_HOURS=1

# --- веб ---
SECRET_KEY=dev-secret-change-me
ADMIN_LOGIN=admin
ADMIN_PASSWORD=admin
