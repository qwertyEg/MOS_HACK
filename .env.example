# Скопировать в .env и поправить под свою машину.

# --- база ---
DATABASE_URL=postgresql+psycopg://stroyka:stroyka@localhost:5432/stroyka

# --- хранилище кадров ---
# s3 = MinIO из docker-compose. local = папка на диске, страховка на случай,
# если MinIO не поднимется в момент демонстрации.
STORAGE_BACKEND=s3
S3_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET=frames

# --- модель Б ---
# Порт 11435, а не стандартный 11434: на машине разработки 11434 занят
# нативным Ollama другого пользователя, наш поднят отдельным контейнером.
VLM_BASE_URL=http://localhost:11435/v1
VLM_API_KEY=ollama
VLM_MODEL=qwen3-vl:30b

# Бюджет большой не потому, что нужен длинный ответ — ответ односложный.
# Qwen3-VL рассуждает перед ответом всегда, отключить это не удаётся
# ни через think:false, ни через enable_thinking, ни через reasoning_effort.
# Если бюджета не хватит, он уйдёт на рассуждение, а content придёт пустым.
VLM_MAX_TOKENS=512

# --- веб ---
SECRET_KEY=dev-secret-change-me
ADMIN_LOGIN=admin
ADMIN_PASSWORD=admin
