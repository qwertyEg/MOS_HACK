# СтройВзор — пример конфигурации. Скопировать в .env и поправить.
# Без .env `python -m app` поднимается на SQLite + локальных файлах.

# --- веб ---
# SECRET_KEY: python -c "import secrets; print(secrets.token_urlsafe(32))". С ключом по умолчанию
# (или короче 16 символов) куки подписываются случайным ключом процесса — сессии сбросятся при рестарте.
SECRET_KEY=change-me-long-random-string
ADMIN_LOGIN=admin
ADMIN_PASSWORD=change-me
# PUBLIC_BASE_URL — адрес, по которому камера-поток (simcam) достучится до сервиса;
# по нему же сверяется Origin изменяющих запросов (защита от CSRF за прокси)
PUBLIC_BASE_URL=http://localhost:8000
APP_PORT=8000
# За TLS-прокси: кука сессии только по https
# SESSION_HTTPS_ONLY=true
# Неверных паролей подряд с одного адреса, потом пауза (с) — ответ 429 без проверки пароля
# LOGIN_MAX_FAILURES=5
# LOGIN_LOCKOUT_S=60
# Лимиты тела запроса: JSON (МБ), один кадр (/api/ingest, /api/analyze), пиксели кадра (Мп)
# MAX_BODY_MB=8
# MAX_FRAME_MB=64
# MAX_IMAGE_MP=50
# Камера-поток на 127.0.0.1 (simcam на той же машине); в сети с чужими сервисами — false
# CAMERA_ALLOW_LOOPBACK=true

# --- база ---
# По умолчанию SQLite в var/app.db. В docker compose DATABASE_URL собирается из POSTGRES_*.
# DATABASE_URL=postgresql+psycopg://stroyvzor:пароль@localhost:5432/stroyvzor
POSTGRES_USER=stroyvzor
POSTGRES_PASSWORD=change-me
POSTGRES_DB=stroyvzor

# --- хранилище кадров: local (var/storage) | s3 (MinIO: docker compose --profile s3) ---
STORAGE_BACKEND=local
# S3_ENDPOINT=http://minio:9000
# S3_ACCESS_KEY=stroyvzor
# S3_SECRET_KEY=change-me-too
# S3_BUCKET=frames

# --- внешний API: GLM-4.6V (z.ai). Без ключа работают локальные модели ---
ZAI_API_KEY=
# ZAI_BASE_URL=https://api.z.ai/api/paas/v4
# ZAI_MODEL=glm-4.6v

# --- локальная VLM по OpenAI-совместимому API (Ollama / vLLM), провайдер local_vlm ---
# VLM_BASE_URL=http://localhost:11434/v1
# VLM_MODEL=qwen2.5vl:7b

# --- локальные модели ---
# веса детектора (файл .pt, каталог с ним или equipment_classes.json) — см. models/README.md
EQUIPMENT_WEIGHTS=models/equipment_yolo.pt
# SigLIP модели Б; та же модель уточняет подтип грузовиков у модели А (одна копия в памяти)
STAGE_CLIP_MODEL=google/siglip2-base-patch16-224
# потоков torch на CPU (на общей машине — ограничить); 0 — как решит torch
# EQUIPMENT_THREADS=3
# EQUIPMENT_REFINE=0            выключить уточнение подтипа грузовиков (truck / crane_manipulator)
# WARM_MODELS=false             не загружать модели при старте (первый кадр подождёт загрузки)
# local | external | hybrid — режим, пока в UI ничего не сохранено
DEFAULT_MODE=local

# --- конвейер ---
# RECOMPUTE_DEBOUNCE_S=3        пересчёт площадки не чаще раза в N секунд
# QUEUE_LIMIT=500               кадров в очереди камеры, дальше /api/ingest → 503
# MAX_UPLOAD_MB=1024
# DEFAULT_INTERVAL_MIN=20
# DEMO_DIR=datasets/demo

# --- образ Docker: 1 — с torch/ultralytics/transformers, 0 — лёгкий (только внешний API) ---
WITH_ML=1
